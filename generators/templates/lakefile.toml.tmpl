# $canary
name = "formal_conjectures_bench_task"
defaultTargets = ["FormalConjecturesBench"]

[leanOptions]
pp.unicode.fun = true
autoImplicit = false
relaxedAutoImplicit = false
maxHeartbeats = 0
maxRecDepth = 4000
synthInstance.maxHeartbeats = 20000
synthInstance.maxSize = 128

[[require]]
name = "formal_conjectures"
path = "/opt/formal-conjectures"

[[lean_lib]]
name = "FormalConjecturesBench"
[lean_lib.leanOptions]
warn.sorry = false
